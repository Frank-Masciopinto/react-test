# Copy to .env for local Docker Compose or native development with PostgreSQL.
POSTGRES_DB=userdir
POSTGRES_USER=userdir
POSTGRES_PASSWORD=userdir
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
